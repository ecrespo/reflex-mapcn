# Optional keys for the demo. Copy this file to .env and fill in only what
# you want to try; every page works without them.
#
# .env is gitignored, this example is not: never commit a filled-in key.

# TomTom traffic tiles, used by the raster-layer recipe in the root README.
# Free tier: https://developer.tomtom.com/
TOMTOM_API_KEY=

# OpenWeather tiles (clouds, precipitation) for a raster layer of your own,
# built like the traffic recipe above.
# Free tier: https://openweathermap.org/api
OPENWEATHER_API_KEY=
